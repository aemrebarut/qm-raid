# Copy to .env (gitignored). No secrets needed: the bridge talks to QM through the
# local dev portal's loopback auth bypass, which signs requests to core itself.
PORT=4614
# Portal URL printed by `bash scripts/dev-instance.sh up` in qm/ (slot pool1 = 8129).
QM_PORTAL_URL=http://localhost:8129
# Optional: the portal user; derived from /api/runtime-config when empty.
QM_PRINCIPAL=
# Conversation namespace: threadRef web:<principal>:raid-<ns>-<unitId>. Change it to give every unit a fresh QM conversation.
QM_THREAD_NS=r1
# Loadout plan B: per-unit QM project scope with the loadout as its SOUL (default off).
LOADOUT_SOUL=
